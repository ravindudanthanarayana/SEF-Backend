# PostgreSQL connection string (Neon in production)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace_with_a_long_random_string"

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="your_gemini_api_key_here"

# Origin(s) of the deployed frontend, comma-separated, used for CORS
FRONTEND_URL="http://localhost:3000"

# Port the backend listens on (Railway sets this automatically)
PORT=4000
